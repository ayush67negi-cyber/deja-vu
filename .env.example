# --- Required -------------------------------------------------------------
# PostgreSQL connection string used by the app (and by drizzle-kit).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Admin panel ----------------------------------------------------------
# Password for /admin. If unset, a temporary demo password ("dejavu-demo-admin")
# is used and a warning banner is shown — set this before going live.
ADMIN_PASSWORD=
# HMAC secret used to sign admin session cookies. If unset, a random
# per-process secret is used (sessions reset on restart).
ADMIN_SESSION_SECRET=

# --- Payments (Razorpay) --------------------------------------------------
# Leave empty to run in demo mode: checkout is simulated and no money moves.
# The demo flow is automatically locked out once real keys are configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: enables /api/razorpay/webhook so payments reconcile even if the
# browser closes mid-checkout.
RAZORPAY_WEBHOOK_SECRET=

# --- Site -----------------------------------------------------------------
# Public origin, used for metadata/OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "1" ONLY if you must serve the admin panel over plain HTTP in
# production (e.g. behind a proxy that terminates TLS without forwarding
# proto headers). Prefer proper HTTPS instead.
COOKIE_INSECURE=
